        <rect x="30" y="90"  width="160" height="8"  rx="2" fill="#3d5a2a"/><text x="196" y="96" class="lab">洞洞板 1.6</text>
        <rect x="30" y="100" width="160" height="4"  fill="#232c40"/>
        <rect x="30" y="106" width="160" height="20" rx="3" fill="#5a2a2a"/><text x="196" y="119" class="lab">电池 8</text>
        <rect x="30" y="128" width="160" height="16" rx="3" fill="#2b3a52"/><text x="196" y="140" class="lab">后壳 2.5</text>
        <!-- 总高标注 -->
        <line x1="30" y1="20" x2="24" y2="20" stroke="#5aa2f0"/>
        <line x1="30" y1="144" x2="24" y2="144" stroke="#5aa2f0"/>
        <line x1="24" y1="20" x2="24" y2="144" stroke="#5aa2f0" stroke-dasharray="3,2"/>
        <text x="20" y="86" fill="#5aa2f0" font-size="11" text-anchor="middle" transform="rotate(-90 20 86)">整机厚 20.6 ≈ 20</text>
        <!-- 隔板标记 -->
        <line x1="110" y1="54" x2="110" y2="58" stroke="#f0b95a" stroke-width="2"/>
        <line x1="110" y1="100" x2="110" y2="104" stroke="#f0b95a" stroke-width="2"/>
        <text x="110" y="52" text-anchor="middle" class="lab" fill="#f0b95a">▲ 可选隔板 1.6/层</text>
        <text x="110" y="163" text-anchor="middle" class="lab" fill="#f0b95a">加隔板 → 总厚 20.6 + 3.2 = 23.8</text>
      </svg>
      <div class="cap">右侧剖视 · 屏幕区比键盘区高约 1.5mm</div>
    </div>
    <div class="note">层叠公式：2.5 + 3 + 6 + 1.6 + 8 + 2.5 = <span class="hl">20.6mm</span>。隔板（防按键顶屏 / 电池压板）每层 <span class="hl">+1.6mm</span>，双隔板 = 23.8mm。</div>
  </div>

  <!-- 背面 -->
  <div class="card">
    <h3>背面（后壳，2.5mm 厚）</h3>
    <div class="view">
      <svg viewBox="0 0 220 320" width="100%">
        <rect x="10" y="10" width="200" height="300" rx="8" fill="#1a2233" stroke="#3a4760" stroke-width="1.5"/>
        <!-- 电池凹槽 -->
        <rect x="30" y="64" width="124" height="210" rx="4" fill="#2a1515" stroke="#f0b95a" stroke-dasharray="5,3"/>
        <text x="92" y="176" text-anchor="middle" class="dim">电池凹槽 62 × 105 × 8.5</text>
        <text x="92" y="190" text-anchor="middle" class="lab">软包 5000mAh · 62×105×8</text>
        <!-- TF -->
        <rect x="10" y="60" width="6" height="26" fill="#0a0e18" stroke="#5aa2f0"/>
        <text x="24" y="78" class="lab">TF 16×13</text>
        <!-- SD -->
        <rect x="204" y="114" width="6" height="66" fill="#0a0e18" stroke="#5aa2f0"/>
        <text x="176" y="152" class="lab" text-anchor="end">SD 27×33</text>
        <!-- USB-C -->
        <rect x="95" y="310" width="30" height="6" fill="#0a0e18" stroke="#5aa2f0"/>
        <text x="110" y="302" text-anchor="middle" class="lab">USB-C 30×10</text>
        <!-- 喇叭孔 -->
        <circle cx="182" cy="82" r="2.5" fill="#0a0e18" stroke="#5aa2f0"/><circle cx="192" cy="82" r="2.5" fill="#0a0e18" stroke="#5aa2f0"/>
        <circle cx="182" cy="92" r="2.5" fill="#0a0e18" stroke="#5aa2f0"/><circle cx="192" cy="92" r="2.5" fill="#0a0e18" stroke="#5aa2f0"/>
        <text x="170" y="72" class="lab" text-anchor="middle">喇叭出声孔 2×2 · Ø2.5</text>
        <circle cx="182" cy="87" r="28" fill="none" stroke="#f0b95a" stroke-dasharray="3,3"/>
        <text x="196" y="112" class="lab">喇叭 Ø28（虚线）</text>
        <!-- 螺丝柱 -->
        <circle cx="18" cy="18" r="6" fill="none" stroke="#b07af0"/><circle cx="202" cy="18" r="6" fill="none" stroke="#b07af0"/>
        <circle cx="18" cy="302" r="6" fill="none" stroke="#b07af0"/><circle cx="202" cy="302" r="6" fill="none" stroke="#b07af0"/>
      </svg>
      <div class="cap">背面视图 · 后壳左上角为原点（与正面同轴）</div>
    </div>
  </div>
</div>

