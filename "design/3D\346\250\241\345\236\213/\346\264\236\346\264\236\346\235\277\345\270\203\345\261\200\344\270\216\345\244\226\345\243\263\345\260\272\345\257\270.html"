  // 场景
  var scene=new THREE.Scene();
  var camera=new THREE.PerspectiveCamera(42,1,1,2000);
  camera.position.set(220,260,240);
  camera.lookAt(0,0,18);
  var renderer=new THREE.WebGLRenderer({antialias:true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  document.getElementById('d3-canvas').appendChild(renderer.domElement);
  var controls=new THREE.OrbitControls(camera,renderer.domElement);
  controls.target.set(0,0,18); controls.enableDamping=true; controls.dampingFactor=0.08;
  var hemi=new THREE.HemisphereLight(0xffffff,0x9aa4b5,0.95); scene.add(hemi);
  var dir=new THREE.DirectionalLight(0xffffff,0.55); dir.position.set(180,120,240); scene.add(dir);
  var dir2=new THREE.DirectionalLight(0xffffff,0.22); dir2.position.set(-160,-100,140); scene.add(dir2);
  // 外壳（半透明 + 线框）
  var shellMesh;
  (function(){
    var g=new THREE.BoxGeometry(W,H,T);
    var m=new THREE.MeshLambertMaterial({color:0x868e96,transparent:true,opacity:0.08,depthWrite:false});
    shellMesh=new THREE.Mesh(g,m); shellMesh.position.set(0,0,T/2); scene.add(shellMesh);
    var e=new THREE.LineSegments(new THREE.EdgesGeometry(g),new THREE.LineBasicMaterial({color:0x495057}));
    e.position.set(0,0,T/2); scene.add(e);
  })();
  // 层 + 元件（Lambert 无镜面高光，层半透明 + 深色描边，靠纯色区分）
  var groups=[], clickables=[];
  function mkLabel(text){
    var c=document.createElement('canvas'); c.width=512; c.height=64;
    var ctx=c.getContext('2d'); ctx.fillStyle='rgba(26,29,35,0.78)';
    ctx.roundRect?ctx.roundRect(4,6,504,52,8):ctx.fillRect(4,6,504,52);
    ctx.fillStyle='#fff'; ctx.font='bold 30px "Segoe UI","Microsoft YaHei",sans-serif';
    ctx.textBaseline='middle'; ctx.textAlign='center'; ctx.fillText(text,256,34);
    var t=new THREE.CanvasTexture(c); t.minFilter=THREE.LinearFilter;
    var sp=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthTest:false}));
    sp.scale.set(60,7.5,1); return sp;
  }
  LAYERS.forEach(function(L,idx){
    var g=new THREE.Group(); g.position.set(0,0,L.zBase);
    var box=new THREE.Mesh(new THREE.BoxGeometry(W,H,L.h),new THREE.MeshLambertMaterial({color:L.color,transparent:true,opacity:0.55}));
    box.position.set(0,0,L.h/2); box.userData.layer=idx; g.add(box); clickables.push(box);
    var edge=new THREE.LineSegments(new THREE.EdgesGeometry(box.geometry),new THREE.LineBasicMaterial({color:0x343a40}));
    edge.position.copy(box.position); g.add(edge);
    (PARTS[L.key]||[]).forEach(function(p){
      var mat=new THREE.MeshLambertMaterial({color:p.color});
      if(p.transparent){mat.transparent=true; mat.opacity=p.transparent;}
      var mesh=new THREE.Mesh(new THREE.BoxGeometry(p.w,p.d,p.h),mat);
      mesh.position.set(p.x,p.y,p.z);
      g.add(mesh); mesh.userData.layer=idx; clickables.push(mesh);
      if(!p.transparent){var pe=new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry),new THREE.LineBasicMaterial({color:0x212529})); pe.position.copy(mesh.position); g.add(pe);}
      if(p.label){var l=mkLabel(p.label); l.position.set(p.x,p.y,p.z+p.h/2+6); g.add(l);}
    });
    // 层名标签
    var lname=mkLabel(L.name); lname.position.set(0,0,L.h+6); g.add(lname);
    groups.push(g); scene.add(g);
  });
  // 爆炸
  var spreadEl=document.getElementById('d3-spread');
  function applySpread(){
    var v=spreadEl.value/100;
    var s=v*v*46; // 非线性：最大 46mm 层间距，拉开才看得见
    groups.forEach(function(g,idx){ g.position.z=LAYERS[idx].zBase+idx*s; });
    // 视角跟随层堆中段，避免上层飞出视野
    var midZ=(LAYERS[0].zBase + LAYERS[4].zBase + 4*s + LAYERS[4].h)/2;
    controls.target.set(0,0,Math.max(18,midZ*0.9));
  }
  spreadEl.addEventListener('input',applySpread); applySpread();
  document.getElementById('d3-shell').addEventListener('change',function(){ shellMesh.visible=this.checked; });
  // 只看单层（隔离模式，彻底防遮挡）
  var layerBtns=document.querySelectorAll('#d3-layers button');
  layerBtns.forEach(function(btn){
    btn.addEventListener('click',function(){
      layerBtns.forEach(function(b){ b.classList.remove('on'); });
      btn.classList.add('on');
      var sel=parseInt(btn.getAttribute('data-layer'),10);
      groups.forEach(function(g,idx){
        g.visible = (sel===-1 || idx===sel);
      });
      shellMesh.visible = document.getElementById('d3-shell').checked && sel===-1;
      if(sel!==-1){
        var L=LAYERS[sel];
        spreadEl.value=0; applySpread();
        controls.target.set(0,0,L.zBase+L.h/2);
      }else{
        applySpread();
      }
    });
  });
  // 点击层
  var raycaster=new THREE.Raycaster(), mouse=new THREE.Vector2(), hover=null;
  var lastHi=[];
  function clearHi(){ lastHi.forEach(function(m){ if(m.material.emissive) m.material.emissive.setHex(0); }); lastHi=[]; }
  renderer.domElement.addEventListener('click',function(e){
    var r=renderer.domElement.getBoundingClientRect();
    mouse.set(((e.clientX-r.left)/r.width)*2-1,-((e.clientY-r.top)/r.height)*2+1);
    raycaster.setFromCamera(mouse,camera);
    var hit=raycaster.intersectObjects(clickables,false);
    if(!hit.length){ clearHi(); document.getElementById('d3-info').innerHTML='<div class="d3-tip">点击任意层查看明细。</div>'; return; }
    var L=LAYERS[hit[0].object.userData.layer];
    clearHi();
    clickables.forEach(function(m){ if(m.userData.layer===L.layer){ if(m.material.emissive) m.material.emissive.setHex(0x6c7a89); lastHi.push(m); } });
    document.getElementById('d3-info').innerHTML='<h4>'+L.name+'</h4><ul>'+L.desc.map(function(d){return '<li>'+d+'</li>';}).join('')+'</ul>';
  });
  // resize
  function resize(){
    var el=document.getElementById('d3-canvas'), w=el.clientWidth, h=el.clientHeight;
    renderer.setSize(w,h); camera.aspect=w/h; camera.updateProjectionMatrix();
  }
  window.addEventListener('resize',resize); resize();
  (function anim(){ requestAnimationFrame(anim); controls.update(); renderer.render(scene,camera); })();
})();
</script>

