</div>

<script>
(function(){
  /* ===== 洞洞板网格图 ===== */
  var svg = document.getElementById('gridSvg');
  var NS = 'http://www.w3.org/2000/svg';
  var COLS=39, ROWS=59, PITCH=2.54, HOLE=0.5, ORIGIN_X=30, ORIGIN_Y=30, SCALE=7;
  function el(tag, attrs){ var e=document.createElementNS(NS,tag); for(var k in attrs){ e.setAttribute(k, attrs[k]); } return e; }
  function px(mm){ return mm*SCALE; }
  var holes = el('g',{id:'holes'});
  // 孔
  for(var c=0;c<COLS;c++){ for(var r=0;r<ROWS;r++){
    var cx = ORIGIN_X + px(c*PITCH), cy = ORIGIN_Y + px(r*PITCH);
    var h = el('circle',{cx:cx, cy:cy, r:HOLE*SCALE*0.42, fill:'#c9ced6'});
    holes.appendChild(h);
  }}
  svg.appendChild(holes);
  // 刻度（每10孔）
  var scaleG = el('g',{});
  for(var c=0;c<=COLS;c+=10){ var x=ORIGIN_X+px(c*PITCH); var l=el('line',{x1:x,y1:ORIGIN_Y,x2:x,y2:ORIGIN_Y+px(ROWS*PITCH),stroke:'#adb5bd','stroke-width':0.5,'stroke-dasharray':'4 3'}); scaleG.appendChild(l);
    var t=el('text',{x:x,y:ORIGIN_Y-6,'font-size':9,fill:'#8a92a2','text-anchor':'middle'}); t.textContent=(c*2.54).toFixed(1); scaleG.appendChild(t);}
  for(var r=0;r<=ROWS;r+=10){ var y=ORIGIN_Y+px(r*PITCH); var l=el('line',{x1:ORIGIN_X,y1:y,x2:ORIGIN_X+px(COLS*PITCH),y2:y,stroke:'#adb5bd','stroke-width':0.5,'stroke-dasharray':'4 3'}); scaleG.appendChild(l);
    var t=el('text',{x:ORIGIN_X-6,y:y+3,'font-size':9,fill:'#8a92a2','text-anchor':'end'}); t.textContent=(r*2.54).toFixed(1); scaleG.appendChild(t);}
  svg.appendChild(scaleG);
  // 元件区域
  function zone(x,y,w,h,fill,label,lx,ly){
    var g=el('g',{});
    var rect=el('rect',{x:ORIGIN_X+px(x),y:ORIGIN_Y+px(y),width:px(w),height:px(h),fill:fill,'fill-opacity':0.32,stroke:fill,'stroke-width':1.2,'stroke-dasharray':'5 3'});
    g.appendChild(rect);
    var t=el('text',{x:ORIGIN_X+px(lx),y:ORIGIN_Y+px(ly),'font-size':10,fill:fill,'font-weight':700}); t.textContent=label; g.appendChild(t);
    return g;
  }
  // 键盘区（60 键帽占位 7×7）
  var kbd=el('g',{});
  for(var m=0;m<6;m++){ for(var n=0;n<10;n++){
    var kx=5+n*10, ky=93+m*10;
    var r=el('rect',{x:ORIGIN_X+px(kx-3.5),y:ORIGIN_Y+px(ky-3.5),width:px(7),height:px(7),fill:'#2f6fed','fill-opacity':0.5,stroke:'#2f6fed','stroke-width':0.8});
    kbd.appendChild(r);
    var c=el('circle',{cx:ORIGIN_X+px(kx),cy:ORIGIN_Y+px(ky),r:1.4,fill:'#fff'});
    kbd.appendChild(c);
  }}
  svg.appendChild(kbd);
  svg.appendChild(zone(0,56.5,26,34,'#e8590c','摇杆 KY-023',27,58));
  svg.appendChild(zone(33,56.5,16,16,'#0ca678','麦克',24,60));
  svg.appendChild(zone(33,73,16,15.5,'#7048e8','功放',30,71));
  svg.appendChild(zone(67,42,15,16,'#e64980','TF 座',63,44));
  svg.appendChild(zone(65,12,30,29,'#f59f00','SD 槽',63,15));
  svg.appendChild(zone(12,16,26.5,17.5,'#1c7ed6','TP4056',10,19));
  svg.appendChild(zone(5,38,19,10,'#2f9e44','开关',3,40));
  svg.appendChild(zone(52,60,45,28,'#7950f2','核心板 45×28',48,58));
  /* 灯带：贴前板内面/底壳内壁，不占洞洞板（v9 对账口径） */
  var ledT=el('text',{x:ORIGIN_X+px(50),y:ORIGIN_Y+px(86),'font-size':9,fill:'#f76707','text-anchor':'middle','font-weight':700}); ledT.textContent='上灯带（贴前板内面，不占板）'; svg.appendChild(ledT);
  var ledB=el('text',{x:ORIGIN_X+px(50),y:ORIGIN_Y+px(151),'font-size':9,fill:'#f76707','text-anchor':'middle','font-weight':700}); ledB.textContent='下灯带（贴底壳内壁，不占板）'; svg.appendChild(ledB);
  // 边框与标题
  var box=el('rect',{x:ORIGIN_X-4,y:ORIGIN_Y-4,width:px(COLS*PITCH)+8,height:px(ROWS*PITCH)+8,fill:'none',stroke:'#1a1d23','stroke-width':2});
  svg.appendChild(box);
  var cap=el('text',{x:ORIGIN_X,y:ORIGIN_Y+px(ROWS*PITCH)+26,'font-size':12,'font-weight':700,fill:'#1a1d23'}); cap.textContent='洞洞板 100×150（39×59 孔）— 深色圆点=孔（2.54 网格），彩色框=元件落孔区，白色圆点=60 键中心';
  svg.appendChild(cap);
  svg.setAttribute('viewBox','0 0 760 1160');
  /* 缩放 + 拖拽 */
  var vb={x:0,y:0,w:760,h:1160}, dragging=null;
  function applyVB(){ svg.setAttribute('viewBox',[vb.x,vb.y,vb.w,vb.h].join(' ')); }
  svg.addEventListener('wheel',function(e){
    e.preventDefault();
    var r=svg.getBoundingClientRect();
    var mx=(e.clientX-r.left)/r.width*vb.w+vb.x;
    var my=(e.clientY-r.top)/r.height*vb.h+vb.y;
    var k=e.deltaY<0?0.82:1.22;
    var nw=Math.min(2600,Math.max(300,vb.w*k));
    var nh=nw*vb.h/vb.w;
    vb.x=mx-(mx-vb.x)*(nw/vb.w);
    vb.y=my-(my-vb.y)*(nh/vb.h);
    vb.w=nw; vb.h=nh;
    applyVB();
  },{passive:false});
  svg.addEventListener('mousedown',function(e){ dragging={x:e.clientX,y:e.clientY}; svg.style.cursor='grabbing'; });
  window.addEventListener('mousemove',function(e){
    if(!dragging) return;
    var r=svg.getBoundingClientRect();
    vb.x-=(e.clientX-dragging.x)/r.width*vb.w;
    vb.y-=(e.clientY-dragging.y)/r.height*vb.h;
    dragging={x:e.clientX,y:e.clientY};
    applyVB();
  });
  window.addEventListener('mouseup',function(){ dragging=null; svg.style.cursor='grab'; });
  svg.style.cursor='grab';
})();
</script>
