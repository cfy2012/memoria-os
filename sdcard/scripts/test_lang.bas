100 REM 语言扩展自检 v1.0（数组/多行函数/递归/TYPE）
110 PRINT "== T1 1D/2D =="
120 DIM A(5)
130 FOR I=0 TO 5
140 A(I) = I*2
150 NEXT I
160 PRINT "A3=";A(3)
170 DIM B(2,3)
180 FOR I=0 TO 1
190 FOR J=0 TO 2
200 B(I,J) = I*10+J
210 NEXT J
220 NEXT I
230 PRINT "B12=";B(1,2)
240 PRINT "== T2 STRARR =="
250 DIM N$(3)
260 N$(0) = "hello"
270 N$(1) = "world"
280 PRINT N$(0);"-";N$(1)
290 PRINT "== T3 FN1 =="
300 DEF FN SQ(X) = X*X
310 PRINT "SQ7=";FN SQ(7)
320 PRINT "== T4 FNML =="
330 DEF FN FAC(N)
340 LET R = 1
350 FOR I=2 TO N
360 R = R*I
370 NEXT I
380 FNRET R
390 END DEF
400 PRINT "FAC6=";FN FAC(6)
410 PRINT "== T5 RECUR =="
420 DEF FN FIB(N)
430 IF N < 2 THEN FNRET N
440 FNRET FN FIB(N-1) + FN FIB(N-2)
450 END DEF
460 PRINT "FIB10=";FN FIB(10)
470 PRINT "== T6 TYPE =="
480 TYPE Point
490 X
500 Y
510 NAME$
520 END TYPE
530 DIM P AS Point
540 P.X = 3
550 P.Y = 4
560 P.NAME$ = "A"
570 PRINT "P=";P.X;",";P.Y;",";P.NAME$
580 DIM PS(2) AS Point
590 PS(1).X = 30
600 PS(1).NAME$ = "B"
610 PRINT "PS1=";PS(1).X;",";PS(1).NAME$
620 PRINT "== DONE =="
